<?xml version="1.0" encoding="utf-8"?>
<!-- 备份规则：视频缓存与日志不参与云备份/设备迁移 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="videos" />
        <exclude domain="file" path="logs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="videos" />
        <exclude domain="file" path="logs" />
    </device-transfer>
</data-extraction-rules>
