    <!-- ===== 权限引导 ===== -->
    <string name="guide_title">权限引导</string>
    <string name="guide_subtitle">为保证 HyperOS 下闹钟准时响起，请依次完成以下设置</string>
    <string name="guide_step_notification">通知权限</string>
    <string name="guide_step_notification_why">响铃时的前台通知与提示需要通知权限，否则无法在通知栏显示停止按钮</string>
    <string name="guide_step_exact_alarm">精确闹钟权限</string>
    <string name="guide_step_exact_alarm_why">允许 App 在设定时刻准点触发闹钟（不受省电策略延迟）</string>
    <string name="guide_step_autostart">自启动</string>
    <string name="guide_step_autostart_why">开机后自动恢复闹钟，否则重启手机后闹钟会失效</string>
    <string name="guide_step_battery">省电策略无限制</string>
    <string name="guide_step_battery_why">避免系统杀后台导致同步与响铃失败，请在系统设置中把本应用设为“无限制”</string>
    <string name="guide_step_full_screen">全屏显示通知</string>
    <string name="guide_step_full_screen_why">锁屏响铃页弹出需要该权限，被拒后响铃时锁屏只剩通知栏条目</string>
