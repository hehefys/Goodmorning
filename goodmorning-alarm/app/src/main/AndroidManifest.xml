<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== 权限 ===== -->
    <!-- 精确闹钟：Android 12+ 需用户授权；USE_EXACT_ALARM 面向闹钟类 App（Android 13+） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 重启后重注册闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 通知（Android 13+ 运行时） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 锁屏全屏响铃页（Android 14+ full-screen intent 需显式声明） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 响铃期间持锁 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 前台服务（媒体播放类型，Android 14+ 必须声明具体类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- 允许自建 HTTP 数据源明文通信：Android 9+ 默认禁止 cleartext，用户配置的
         RSSHub 地址可能是 http:// IP 形式（如 http://81.70.52.12:1200），需放行 -->
    <application
        android:name=".GoodMorningApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoodMorningAlarm"
        tools:targetApi="35">

        <!-- ===== 主入口 ===== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GoodMorningAlarm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== 锁屏全屏响铃页 ===== -->
        <activity
            android:name=".ui.ringing.RingingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.GoodMorningAlarm" />

        <!-- ===== 闹钟到点接收器（精确闹钟触发，允许后台启动前台服务） ===== -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- ===== 开机/时间变化重注册 ===== -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- ===== 响铃前台服务（mediaPlayback 类型） ===== -->
        <service
            android:name=".playback.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
