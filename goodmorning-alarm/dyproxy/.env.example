# dyproxy 环境变量模板
#
# 用法：
#   cp .env.example .env
#   填入真实 DOUYIN_COOKIE
#
# 注意：.env 含账号登录凭据，已在仓库根 .gitignore 中排除，切勿提交、切勿外发。
#       每个变量单独一行，值不要加引号，不要换行。

# ---------- 必填 ----------

# 抖音网页版整串 Cookie。以 ttwid= 开头，必须包含
# ttwid / sessionid_ss / sid_tt / odin_tt / passport_csrf_token
#
# ⚠️ 整串约 6500 字符，切勿用终端粘贴（会被静默截断到 1024 字符且不报错），
#    请用 scp 传文件，或用 VS Code Remote-SSH 打开文件粘贴。
DOUYIN_COOKIE=在这里粘贴抖音网页版整串Cookie

# ---------- 可选（一般不用改）----------

# 监听端口
# PORT=1200

# 抓取模式：
#   auto    （默认）先试轻量 HTTP 直连，失败再退回浏览器
#   browser 只用浏览器（最稳，v4 的默认行为）
#   http    只用直连（抖音放宽时才可用，一般会 403）
# FETCH_MODE=auto

# 抓到的数据缓存多久（毫秒）。同一个博主在此时间内重复请求直接返回缓存，
# 不会反复开浏览器。默认 10 分钟。
# CACHE_TTL_MS=600000

# 浏览器可执行文件路径。留空则用 playwright 自带的 chromium。
# 想复用系统已装的 Chrome/Chromium 时才需要设，例如：
#   CHROME_PATH=/usr/bin/chromium
# CHROME_PATH=

# 单次浏览器抓取的超时（毫秒）。App 端有 45s 总闸，别设太大。
# BROWSER_TIMEOUT_MS=35000

# 每次抓取取多少条作品（浏览器模式生效，默认 20）
# COUNT=20

# 覆盖浏览器 User-Agent（一般不用改）
# DOUYIN_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
