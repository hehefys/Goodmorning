# dyproxy 环境变量模板
#
# 用法：
#   cp .env.example .env
#   填入真实 DOUYIN_COOKIE
#
# 注意：.env 含账号登录凭据，已在仓库根 .gitignore 中排除，切勿提交、切勿外发。
#       整行只能有一行，值不要加引号，不要换行。

# 抖音网页版整串 Cookie。以 ttwid= 开头，必须包含
# ttwid / sessionid_ss / sid_tt / odin_tt / passport_csrf_token
DOUYIN_COOKIE=在这里粘贴抖音网页版整串Cookie

# 监听端口（compose 里已固定 1200，一般不用改）
# PORT=1200
